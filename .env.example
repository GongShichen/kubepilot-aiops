# Server
HTTP_ADDR=:8080
API_TOKEN=change-me
ALERTMANAGER_WEBHOOK_TOKEN=change-alert-token
DATABASE_URL=postgres://kubepilot:kubepilot@postgres:5432/kubepilot?sslmode=disable
REDIS_URL=redis://agent-redis:6379/0

# Model: openai-compatible or anthropic-compatible
CHAT_PROTOCOL=openai-compatible
CHAT_BASE_URL=
CHAT_API_PATH=/chat/completions
CHAT_API_KEY=
CHAT_MODEL=
CHAT_TIMEOUT=60s
CHAT_MAX_RETRIES=1
CHAT_MAX_TOKENS=4096
CHAT_TEMPERATURE=0
CHAT_REASONING_EFFORT=
CONFIG_RELOAD_INTERVAL=2s
CONFIG_RELOAD_RETRY_INTERVAL=30s

# Embedding model served through an OpenAI-compatible embeddings endpoint
EMBEDDING_BASE_URL=
EMBEDDING_API_PATH=/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_CONCURRENCY=1
EMBEDDING_REQUEST_INTERVAL=1s
EMBEDDING_TIMEOUT=30s

# Optional OpenAI-style /reranks endpoint. URL, key and model have no defaults.
RERANKER_ENABLED=false
RERANKER_PROTOCOL=openai-compatible
RERANKER_BASE_URL=
RERANKER_API_PATH=/reranks
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_TIMEOUT=30s
RERANKER_MAX_RETRIES=1
RERANKER_MAX_DOCUMENT_BYTES=4096
RERANKER_MAX_PAYLOAD_BYTES=131072

# Evidence systems
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
JAEGER_URL=http://jaeger:16686
BUSINESS_PROBE_URL=
MILVUS_ADDRESS=milvus:19530
HISTORY_COLLECTION=kubepilot_history
LOG_INDEX_COLLECTION=kubepilot_log_templates
LOG_INDEXER_INTERVAL=2s
DRAIN3_WS_URL=ws://drain3:8081/ws/v1/parse
DRAIN3_TOKEN=change-drain3-token
KUBECONFIG=
ALLOWED_NAMESPACES=kubepilot-demo,kubepilot-benchmark

# Incident Reasoning Engine
RETRIEVAL_SEMANTIC_TOP_K=50
RETRIEVAL_LEXICAL_TOP_K=50
RETRIEVAL_TOPOLOGY_TOP_K=50
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_TOP_K=5
RANKING_POLICY_FILE=knowledge/ranking_policy.yaml
TOOL_COST_FILE=internal/agent/skills/tool_costs.yaml

# Constrained ReAct budgets
SUPERVISOR_MAX_ITERATIONS=10
SUPERVISOR_MAX_TOOL_USES=8
SUPERVISOR_MAX_TOOL_COST=24
SUPERVISOR_MAX_TOKENS=12000
SUPERVISOR_MAX_CORRECTIONS=3
DIAGNOSIS_MAX_ITERATIONS=12
DIAGNOSIS_MAX_TOOL_USES=15
DIAGNOSIS_MAX_TOOL_COST=32
DIAGNOSIS_MAX_TOKENS=30000
DIAGNOSIS_MAX_CORRECTIONS=3
RECOVERY_MAX_ITERATIONS=10
RECOVERY_MAX_TOOL_USES=10
RECOVERY_MAX_TOOL_COST=16
RECOVERY_MAX_TOKENS=16000
RECOVERY_MAX_CORRECTIONS=2
INCIDENT_MAX_AGENT_TOOL_USES=30
INCIDENT_MAX_AGENT_TOOL_COST=72
INCIDENT_MAX_TOKENS=58000
MODEL_EVIDENCE_MAX_ITEMS=12
MODEL_CONTEXT_MAX_BYTES=32768
CAUSAL_AUTO_ACTIVATE_CONFIDENCE=0.90
CAUSAL_LEARNING_NAMESPACES=kubepilot-demo
CAUSAL_PATTERN_FILE=knowledge/causal_patterns.yaml
CAUSAL_PATTERN_DIR=knowledge/patterns

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
OTEL_SERVICE_NAME=kubepilot-agent
